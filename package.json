{
  "name": "melofin",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "demo:jellyfin": "node scripts/demo-jellyfin/seed.mjs",
    "demo:jellyfin:down": "node scripts/demo-jellyfin/down.mjs",
    "screenshots": "node scripts/screenshots/capture.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "i18n:check:parity": "node scripts/i18n/check-parity.mjs",
    "i18n:check:hardcoded": "node scripts/i18n/check-hardcoded-ui.mjs",
    "i18n:check:pseudo": "node scripts/i18n/check-pseudo.mjs",
    "i18n:check": "npm run i18n:check:parity && npm run i18n:check:hardcoded && npm run i18n:check:pseudo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:coverage": "vitest run --coverage --config vitest.config.mts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@jellyfin/sdk": "0.13.0",
    "@react-native-community/netinfo": "11.4.1",
    "@shopify/flash-list": "2.3.2",
    "airplay-route-picker": "file:modules/airplay-route-picker",
    "axios": "1.19.0",
    "expo": "54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "^57.0.1",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.4.0",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^11.2.14",
    "intl-pluralrules": "^2.0.1",
    "melofin-audio-graph": "file:modules/melofin-audio-graph",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.12",
    "react-native": "0.81.5",
    "react-native-carplay": "2.4.1-beta.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-cast": "4.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2",
    "vitest": "4.1.11"
  }
}
