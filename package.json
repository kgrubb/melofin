{
  "name": "melofin",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "demo:jellyfin": "node scripts/demo-jellyfin/seed.mjs",
    "demo:jellyfin:down": "node scripts/demo-jellyfin/down.mjs",
    "screenshots": "node scripts/screenshots/capture.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "i18n:check:parity": "node scripts/i18n/check-parity.mjs",
    "i18n:check:hardcoded": "node scripts/i18n/check-hardcoded-ui.mjs",
    "i18n:check:pseudo": "node scripts/i18n/check-pseudo.mjs",
    "i18n:check": "npm run i18n:check:parity && npm run i18n:check:hardcoded && npm run i18n:check:pseudo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:coverage": "vitest run --coverage --config vitest.config.mts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@jellyfin/sdk": "0.13.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.3.2",
    "airplay-route-picker": "file:modules/airplay-route-picker",
    "axios": "1.20.0",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.3",
    "i18next-icu": "^2.5.0",
    "intl-messageformat": "^11.2.15",
    "intl-pluralrules": "^2.0.1",
    "melofin-audio-graph": "file:modules/melofin-audio-graph",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-carplay": "2.4.1-beta.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-cast": "4.9.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "0.21.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    }
  }
}
